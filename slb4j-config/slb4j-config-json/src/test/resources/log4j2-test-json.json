{
    "Configuration": {
        "status": "DEBUG",
        "Appenders": {
            "Console": {
                "name": "STDOUT",
                "target": "SYSTEM_OUT",
                "ThresholdFilter": {
                    "level": "INFO",
                    "onMatch": "ACCEPT",
                    "onMismatch": "DENY"
                },
                "PatternLayout": {
                    "pattern": "%highlight{%msg}%n",
                    "disableAnsi": true
                }
            }
        },
        "Loggers": {
            "Root": {
                "level": "INFO",
                "AppenderRef": {
                    "ref": "STDOUT"
                }
            },
            "Logger": {
                "name": "org.slb4j.test",
                "level": "DEBUG"
            }
        }
    }
}
